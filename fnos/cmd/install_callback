#!/bin/bash
# 安装后置回调:向导收集字段写入数据目录 .env,cmd/main 启动时 source。
#
# 字段契约(wizard/config 与 install 一致):
#   PB_JWT_SECRET             留空沿用自动生成
#   PB_ADMIN_PASSWORD         非空=重置管理员密码为该值(置 .admin_reset 标记,
#                              cmd/main 启动前删 admin 用户,core 按 env 重建);留空=不改动
#   PB_SERVER_PORT            服务端口(同步安装目录 manifest.service_port 供框架入口探测;
#                              进程监听端口由 cmd/main prepare_env 消费)
#
# 飞牛深度集成(2026-10-09 起)无需任何用户凭证:统一网关(SSO 免登录)、
# 官方后端 API(TRIM_API_TOKEN 由框架注入)均由 fnOS 运行环境自动就绪。
#
# 优先 ${TRIM_PKGVAR}/.env(数据卷,升级保留);目录不可写时回退包根
# ${TRIM_APPDEST}/.env(cmd/main 两处都找)。写失败不阻断。

quote() {
  printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\$/\\$/g')"
}

write_env() {
  umask 077
  cat > "$1" <<EOF
# 由飞牛向导生成(cmd/install_callback 或 config_callback),手工修改后需在应用设置重新提交或重启应用
PB_JWT_SECRET=$(quote "$PB_JWT_SECRET")
PB_ADMIN_PASSWORD=$(quote "$PB_ADMIN_PASSWORD")
PB_SERVER_PORT=$(quote "$PB_SERVER_PORT")
EOF
}

if mkdir -p "${TRIM_PKGVAR}" 2>/dev/null && write_env "${TRIM_PKGVAR}/.env" 2>/dev/null; then
  echo "wizard env written: ${TRIM_PKGVAR}/.env"
else
  if write_env "${TRIM_APPDEST}/.env" 2>/dev/null; then
    echo "wizard env written (fallback): ${TRIM_APPDEST}/.env"
  else
    echo "warn: could not write wizard env (both paths failed); fill via app settings later"
  fi
fi

# 管理员密码重置请求:cmd/main 启动前消费(删 admin 用户,core 按 PB_ADMIN_PASSWORD 重建)。
if [ -n "$PB_ADMIN_PASSWORD" ]; then
  : > "${TRIM_PKGVAR}/.admin_reset" 2>/dev/null || : > "${TRIM_APPDEST}/.admin_reset" 2>/dev/null || true
  echo "admin password reset requested (consumed on next start)"
fi

# 端口同步:更新安装目录 manifest 的 service_port,使框架入口/健康探测跟随新端口。
# 进程监听端口由 .env/框架 env → cmd/main prepare_env 消费;manifest sed 失败不阻断
# (进程侧端口仍生效,仅框架入口展示可能滞后)。
if [ -n "$PB_SERVER_PORT" ] && [ -r "${TRIM_APPDEST}/manifest" ] && [ -w "${TRIM_APPDEST}/manifest" ]; then
  if sed -i.bak "s/^service_port=.*/service_port=${PB_SERVER_PORT}/" "${TRIM_APPDEST}/manifest" 2>/dev/null; then
    rm -f "${TRIM_APPDEST}/manifest.bak"
    echo "manifest service_port synced to ${PB_SERVER_PORT}"
  fi
fi

exit 0
