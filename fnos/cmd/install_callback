#!/bin/bash
# 安装后置:把向导收集的凭证写入数据目录 .env,cmd/main 启动时 source。
#
# 优先 ${TRIM_PKGVAR}/.env(数据卷,升级保留);目录不可写时回退包根
# ${TRIM_APPDEST}/.env(cmd/main 两处都找)。写失败不阻断安装——凭证
# 可随时在应用设置(配置向导)补填,留空=降级模式+JWT 自动生成。
# FNOS_ENABLED 由凭证是否齐全推导,不单独向用户收集。

quote() {
  printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\$/\\$/g')"
}

write_env() {
  umask 077
  cat > "$1" <<EOF
# 由飞牛向导生成(cmd/install_callback 或 config_callback),手工修改后需在应用设置重新提交或重启应用
FNOS_ENABLED=$(quote "$ENABLED")
FNOS_APPID=$(quote "$FNOS_APPID")
FNOS_APPSECRET=$(quote "$FNOS_APPSECRET")
FCB_JWT_SECRET=$(quote "$FCB_JWT_SECRET")
EOF
}

ENABLED="false"
if [ -n "$FNOS_APPID" ] && [ -n "$FNOS_APPSECRET" ]; then
  ENABLED="true"
fi

if mkdir -p "${TRIM_PKGVAR}" 2>/dev/null && write_env "${TRIM_PKGVAR}/.env" 2>/dev/null; then
  echo "wizard env written: ${TRIM_PKGVAR}/.env (FNOS_ENABLED=$ENABLED)"
  exit 0
fi

if write_env "${TRIM_APPDEST}/.env" 2>/dev/null; then
  echo "wizard env written (fallback): ${TRIM_APPDEST}/.env (FNOS_ENABLED=$ENABLED)"
  exit 0
fi

echo "warn: could not write wizard env (both paths failed); fill via app settings later"
exit 0
