#!/bin/bash
# FilesCodeBox 飞牛(fnOS)应用生命周期脚本(Docker 项目模式)
#
# start/stop 由 fnOS 依据 config/resource 的 docker-project 声明接管,直接退出即可;
# status 需自行检测容器运行态(与应用中心"运行中"状态展示相关),
# 官方约定: exit 0 = 运行中,其他 = 未运行。
# CONTAINER_NAME 必须与 app/docker/docker-compose.yaml 的 container_name 一致。

CONTAINER_NAME="filescodebox"

is_running() {
  docker inspect "$CONTAINER_NAME" 2>/dev/null | grep -q '"Status": "running"'
}

case "$1" in
  start)
    exit 0
    ;;
  stop)
    exit 0
    ;;
  status)
    if is_running; then
      exit 0
    fi
    exit 3
    ;;
  *)
    echo "Unknown command: $1" > "$TRIM_TEMP_LOGFILE"
    exit 1
    ;;
esac
